# Captured and generated vision data. Keep Markdown test reports tracked.
/recordings/**/*.mp4
/recordings/**/*.avi
/recordings/**/*.mov
/recordings/**/*.mkv
/recordings/**/*.jsonl
/recordings/**/*.jpg
/recordings/**/*.jpeg
/recordings/**/*.png
/recordings/**/trials/
/recordings/**/results*/
/recordings/**/TEST_REPORT*.md

# Large/local capture artifacts. Keep reports, summaries, checksums and small
# report figures versionable; see artifacts/README.md for separate storage.
/artifacts/**/*.mp4
/artifacts/**/*.avi
/artifacts/**/*.mov
/artifacts/**/*.mkv
/artifacts/**/*.h264
/artifacts/**/*.h265
/artifacts/**/*.raw
/artifacts/**/*.nv12
/artifacts/**/*.nv21
/artifacts/**/*.zip
/artifacts/**/*.tar.gz
/artifacts/**/*.tgz

# Private/large training data and model artifacts. Keep contracts/templates.
/datasets/
/models/runtime/*
!/models/runtime/.gitkeep
*.pt
*.onnx
*.axmodel
*.tar

